# Copy to .env and fill in. DISCORD_TOKEN and PUBLIC_URL are the ones you need.

# The bot's token (Discord Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=
# The server the commands are registered in (right-click it > Copy Server ID); blank = every server the bot is in
DISCORD_GUILD_ID=

# How people reach the browse page through your reverse proxy, for /browse links
PUBLIC_URL=https://band3.example.com
# What band3 shows in Settings > Online
BOT_NAME=band3-bot
# What band3 is told to use; blank = http://<the bot's LAN address>:<PORT>
ADVERTISE_URL=
PORT=8080

# Optional Discord roles (name or ID). REQUESTER_ROLE: only they can request.
# APPROVER_ROLE: requests wait for an approver's button; approvers can pair games.
REQUESTER_ROLE=
APPROVER_ROLE=
# Requests per user per 24 hours (approvers aren't limited); 0 = no limit
PER_USER_LIMIT=5
# Ask games for album art for the browse page
SHARE_ALBUM_ART=true
# Signs /browse links; blank = generated once and kept in /config
SECRET=

# For running outside Docker
# CONFIG_DIR=./config
# LIBRARY_PAGE=web/library.html
